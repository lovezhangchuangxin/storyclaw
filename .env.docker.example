# Docker Compose secrets (copy to .env before running docker compose up)

# PostgreSQL password
POSTGRES_PASSWORD=changeme-use-a-strong-password

# JWT secret for auth tokens (generate: openssl rand -base64 48)
JWT_SECRET=

# Model encryption key (generate: openssl rand -hex 32)
MODEL_ENCRYPTION_KEY=

# CORS origin (the URL users access the app from)
CORS_ORIGIN=http://localhost

# Backend log level
RUST_LOG=storyclaw_backend=info,tower_http=warn

# Web port (default: 80)
WEB_PORT=80
