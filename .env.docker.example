# Docker Compose secrets (copy to .env before running docker compose up)

# Your domain name (required for HTTPS via Caddy + Let's Encrypt)
DOMAIN=storyclaw.example.com

# PostgreSQL password
POSTGRES_PASSWORD=changeme-use-a-strong-password

# JWT secret for auth tokens (generate: openssl rand -base64 48)
JWT_SECRET=

# Model encryption key (generate: openssl rand -hex 32)
MODEL_ENCRYPTION_KEY=

# CORS origin (REQUIRED: set to https://your-domain.com, e.g. https://storyclaw.example.com)
CORS_ORIGIN=

# Backend log level
RUST_LOG=storyclaw_backend=info,tower_http=warn

# LLM proxy limits (per user)
DAILY_TOKEN_LIMIT=1000000
RATE_LIMIT_RPM=20
