# StoryClaw Backend Configuration

# PostgreSQL connection
DATABASE_URL=postgres://localhost:5432/storyclaw

# Redis connection (for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# JWT secret key (generate with: openssl rand -base64 64)
JWT_SECRET=change-me-in-production-use-a-random-64-char-string

# Server port
PORT=3000

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Log level
RUST_LOG=storyclaw_backend=debug,tower_http=debug

# LLM proxy — 模型代理配置（支持任何 OpenAI 兼容接口）
# 用户在前端开启"使用后端代理"后，请求会通过这里转发
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
